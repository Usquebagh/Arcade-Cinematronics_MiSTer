# Connected machine analysis/synthesis, without the MiSTer platform wrapper.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY starcastle_machine
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY ../build/quartus-machine
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ccpu/ccpu.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/games/starcastle_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/games/starcastle_machine.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/io/starcastle_io.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/machine/cinemat_timing.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/machine/cinemat_watchdog.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vector/vector_queue.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vector/vector_line.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vector/vector_framebuffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/vector/vector_video.sv
set_global_assignment -name SDC_FILE CCPU-Synthesis.sdc
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
